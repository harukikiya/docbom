{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocBOM Project Lock v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "catalog_revision",
    "resolver_version",
    "documents"
  ],
  "properties": {
    "lock_version": {
      "const": 1
    },
    "catalog_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resolver_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/lockedArtifact"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "kind",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "source",
            "capture"
          ]
        },
        "kind": {
          "enum": [
            "pdf",
            "git_file",
            "web_snapshot",
            "file"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capture_id": {
          "type": "string"
        },
        "resource_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "web_snapshot"
              }
            }
          },
          "then": {
            "required": [
              "capture_id",
              "resource_manifest_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "git_file"
              }
            }
          },
          "then": {
            "required": [
              "repository_url",
              "commit",
              "source_path"
            ]
          }
        }
      ]
    }
  }
}
